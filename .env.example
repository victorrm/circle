# Copie para .env.local e preencha. O .env.local não vai para o Git.

# ---------------------------------------------------------------------------
# Aplicação — precisa existir também no host (Vercel, etc.)
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# A chave "publishable" (sb_publishable_...), não a "secret".
# Ela vai para o bundle do navegador por natureza — não é segredo. Quem protege
# os dados é a RLS, não o sigilo desta chave.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------------------
# Administração — SÓ na máquina de quem roda migrações. NUNCA no host.
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string → URI (Session pooler).
# Ignora a RLS: é o super-usuário do banco. Usada por db:migrate, db:seed e
# db:invite, jamais pela aplicação.
#
# Caracteres especiais na senha precisam de URL-encoding:
#   ;  →  %3B      #  →  %23      '  →  %27      +  →  %2B      @  →  %40
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Seed inicial (opcional) — usado só por `pnpm db:seed`
# ---------------------------------------------------------------------------
# SEED_TEAM_ID=GERAL
# SEED_TEAM_NAME=Time Geral
# SEED_TEAM_PREFIX=GER
